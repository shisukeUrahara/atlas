# Leave empty to run in replay mode (answers and embeddings come from the committed cache).
OPENAI_API_KEY=
# Folder that holds fixtures/ cache/ runs/ data/. Default: current folder.
ATLAS_DATA_DIR=
# Qdrant URL. Empty = in-process vector store (fine for the demo corpora).
ATLAS_QDRANT_URL=
# Answer model. Default: gpt-4.1-mini-2025-04-14
ATLAS_MODEL=
